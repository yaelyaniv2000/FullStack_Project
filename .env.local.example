# Copy this file to .env.local and fill in real values from your Supabase project
# (Project Settings -> API). Never commit .env.local itself.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (the Supabase "Secret key", not "Publishable key") — used for admin operations
# like creating worker accounts (auth.admin.createUser). Never expose this to the browser (no
# NEXT_PUBLIC_ prefix) and never commit its real value.
SUPABASE_SERVICE_ROLE_KEY=